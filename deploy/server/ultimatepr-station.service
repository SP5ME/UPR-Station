[Unit]
Description=UPR Station packet radio server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ultimatepr
Group=ultimatepr
WorkingDirectory=/var/lib/ultimatepr
ExecStart=/opt/ultimatepr-station/current/ultimatepr-station --bind 127.0.0.1:8080 --config /etc/ultimatepr/station.conf --web-config /etc/ultimatepr/web.conf
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/etc/ultimatepr /var/lib/ultimatepr

[Install]
WantedBy=multi-user.target

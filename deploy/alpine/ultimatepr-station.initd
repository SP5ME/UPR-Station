#!/sbin/openrc-run

name="ultimatepr-station"
description="UltimatePR Station web and packet-radio server"
command="/usr/local/libexec/ultimatepr-station-run"
# The launcher drops privileges to ultimatepr itself.  This avoids the
# command_user/cgroup interaction present in OpenRC inside Alpine LXC.
output_log="/var/log/ultimatepr-station.log"
error_log="/var/log/ultimatepr-station.log"
supervisor="supervise-daemon"
supervise_daemon_args="--group ultimatepr --respawn-delay 2 --stdout ${output_log} --stderr ${error_log}"

depend() {
    need net
    after firewall
}

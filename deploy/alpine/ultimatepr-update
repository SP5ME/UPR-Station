#!/bin/sh
# package-server.py embeds the reviewed ZIP validator below. Unexpanded source
# helpers fail closed; the installed helper is entirely self-contained.
set -eu
[ "$(id -u)" -eq 0 ] || { echo 'Root required.' >&2; exit 1; }
[ ! -f /.dockerenv ] || { echo 'Docker updates must run on the host.' >&2; exit 1; }
case "${1:-}" in
    --request) PACKAGE=/var/lib/ultimatepr/update/incoming.zip; STATUS_DIR=/var/lib/ultimatepr/update ;;
    --install)
        [ -z "${DOAS_USER:-}" ] || { echo 'Only fixed update requests are permitted.' >&2; exit 1; }
        PACKAGE=${2:?Missing ZIP}; STATUS_DIR=${3:?Missing status directory}
        [ "$STATUS_DIR" = /var/lib/ultimatepr/update ] || { echo 'Invalid status directory.' >&2; exit 1; } ;;
    *) echo 'Usage: ultimatepr-update --request | --install ZIP /var/lib/ultimatepr/update' >&2; exit 2 ;;
esac
INSTALL_ROOT=/opt/ultimatepr-station
RELEASES="$INSTALL_ROOT/releases"
CURRENT="$INSTALL_ROOT/current"
SERVICE=ultimatepr-station
MANAGER=openrc
[ ! -d /run/systemd/system ] || MANAGER=systemd
if [ "$MANAGER" = openrc ]; then
    command -v rc-service >/dev/null 2>&1 || { echo 'Managed OpenRC service required.' >&2; exit 1; }
fi
STAGE=$(mktemp -d /var/tmp/ultimatepr-update.XXXXXX)
LOCKED=0
SWITCHED=0
TERMINAL=0
cleanup() {
    rm -rf "$STAGE"
    [ "$LOCKED" != 1 ] || rmdir /run/lock/upr-station-install 2>/dev/null || true
}
finish() {
    result=$?
    trap - EXIT HUP INT TERM
    if [ "$result" != 0 ] && [ "$SWITCHED" = 1 ]; then
        if rollback; then
            status rolled-back "${VERSION:-}" 'Nowa wersja nie przeszła kontroli. Przywrócono i sprawdzono poprzednią wersję. Dane zachowane.' || true
        else
            status failed "${VERSION:-}" 'Nie powiodło się uruchomienie ani przywrócenie usługi. Sprawdź log; dane zachowane.' || true
        fi
    elif [ "$result" != 0 ] && [ "$TERMINAL" != 1 ]; then
        status failed "${VERSION:-}" 'Helper przerwał aktualizację. Sprawdź log usługi; dane zachowane.' || true
    fi
    cleanup
    exit "$result"
}
trap finish EXIT
trap 'exit 1' HUP INT TERM
# Status writes run as the service user, never as root through a writable path.
status() {
    case "$1" in completed|failed|rolled-back) TERMINAL=1 ;; esac
    printf 'state=%s\nversion=%s\nlog=%s\n' "$1" "${2:-}" "$3" |
        su -s /bin/sh -c 'umask 027; cat > /var/lib/ultimatepr/update/status.next && mv -f /var/lib/ultimatepr/update/status.next /var/lib/ultimatepr/update/status.txt' ultimatepr
}
fail() { status failed "" "$1"; exit 1; }

station_pids() {
    pids=$(pidof ultimatepr-station 2>/dev/null || true)
    if [ -z "$pids" ]; then
        pids=$(ps -o pid,args 2>/dev/null | awk '$0 ~ /ultimatepr-station --bind/ {print $1}')
    fi
    for pid in $pids; do
        executable=$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)
        case "$executable" in "$RELEASES"/*/ultimatepr-station) printf '%s\n' "$pid" ;; esac
    done
}
stop_station_processes() {
    if [ "$MANAGER" = systemd ]; then
        systemctl stop "$SERVICE"
        ! systemctl is-active --quiet "$SERVICE"
        return
    fi
    rc-service "$SERVICE" stop >/dev/null 2>&1 || true
    rc-service "$SERVICE" zap >/dev/null 2>&1 || true
    for _ in $(seq 1 15); do
        pids=$(station_pids)
        [ -n "$pids" ] || return 0
        kill -TERM $pids 2>/dev/null || true
        sleep 1
    done
    pids=$(station_pids)
    [ -z "$pids" ] || kill -KILL $pids 2>/dev/null || true
    for _ in 1 2 3 4 5; do
        [ -z "$(station_pids)" ] && return 0
        sleep 1
    done
    [ -z "$(station_pids)" ]
}
current_binary() { readlink -f "$CURRENT/ultimatepr-station" 2>/dev/null || true; }
current_process_running() {
    expected=$(current_binary)
    [ -n "$expected" ] || return 1
    for pid in $(station_pids); do
        actual=$(readlink -f "/proc/$pid/exe" 2>/dev/null || true)
        [ "$actual" = "$expected" ] && return 0
    done
    return 1
}
wait_for_current_process() {
    for _ in $(seq 1 30); do current_process_running && return 0; sleep 1; done
    return 1
}
wait_for_health() {
    for _ in $(seq 1 30); do
        [ "$(wget -q -T 2 -O - "$HEALTH_URL" 2>/dev/null || true)" = ok ] && return 0
        sleep 1
    done
    return 1
}
start_and_wait() {
    if [ "$MANAGER" = systemd ]; then systemctl start "$SERVICE" || return 1
    else
        rc-service "$SERVICE" zap >/dev/null 2>&1 || true
        rc-service "$SERVICE" start || return 1
    fi
    wait_for_health || return 1
    wait_for_current_process
}
rollback() {
    stop_station_processes || return 1
    rm -f "$CURRENT" || return 1
    ln -s "$OLD_TARGET" "$CURRENT" || return 1
    if ! start_and_wait; then stop_station_processes || true; return 1; fi
}

mkdir -p /run/lock "$RELEASES"
if [ "${UPR_INSTALL_LOCK_HELD:-0}" != 1 ] || [ -n "${DOAS_USER:-}" ]; then
    mkdir /run/lock/upr-station-install 2>/dev/null || fail 'Inny instalator jest uruchomiony.'
    LOCKED=1
fi
rm -f /var/lib/ultimatepr/update/install.request
command -v python3 >/dev/null 2>&1 || fail 'Wymagany Python 3: zainstaluj python3 i ponów aktualizację.'
command -v wget >/dev/null 2>&1 || fail 'Brak wget do kontroli działania panelu.'
[ -L "$CURRENT" ] || fail 'Brak zarządzanej instalacji Station.'
OLD_TARGET=$(readlink -f "$CURRENT")
case "$OLD_TARGET" in "$RELEASES"/*) ;; *) fail 'Nieprawidłowy katalog poprzedniej wersji.' ;; esac
[ -x "$OLD_TARGET/ultimatepr-station" ] || fail 'Brak poprzedniej binarki do wycofania aktualizacji.'
status validating "" 'Sprawdzanie binarnej paczki aktualizacji…'
if [ "${1:-}" = --request ]; then
    su -s /bin/sh -c 'head -c 134217729 /var/lib/ultimatepr/update/incoming.zip' ultimatepr > "$STAGE/incoming.zip" || fail 'Nie można odczytać paczki.'
else cp "$PACKAGE" "$STAGE/incoming.zip" || fail 'Nie można skopiować paczki.'; fi
PACKAGE="$STAGE/incoming.zip"
ARCH=$(uname -m)
case "$ARCH:$(getconf LONG_BIT)" in x86_64:64) ARCH=x86_64 ;; aarch64:64) ARCH=aarch64 ;; armv7*:32|aarch64:32) ARCH=armv7 ;; *) fail 'Nieobsługiwana architektura.' ;; esac
if ! python3 -I - "$PACKAGE" "$ARCH" "$STAGE/package" <<'UPR_VALIDATE'
raise SystemExit('Unexpanded helper: build a binary package with package-server.py')
UPR_VALIDATE
then fail 'Nieprawidłowy ZIP, suma kontrolna, produkt lub architektura. Usługa nie została zatrzymana.'; fi
ROOT="$STAGE/package"
MANIFEST="$ROOT/PACKAGE-MANIFEST.txt"
VERSION=$(awk -F= '$1=="version" {print $2;exit}' "$MANIFEST")
PACKAGE_SHA=$(sha256sum "$PACKAGE" | awk '{print $1}')
RELEASE="$RELEASES/$VERSION-$PACKAGE_SHA"
[ ! -e "$RELEASE" ] || fail 'Ta paczka już istnieje w katalogu wydań. Nie nadpisano jej.'
HEALTH_URL=$(python3 -I - <<'PY'
import ipaddress
from pathlib import Path
bind = '127.0.0.1:8080'
for line in Path('/etc/ultimatepr/web.conf').read_text().splitlines():
    key, separator, value = line.partition('=')
    if separator and key.strip() == 'bind': bind = value.strip()
host, port = bind.rsplit(':', 1)
address = ipaddress.ip_address(host.strip('[]'))
if address.is_unspecified: address = ipaddress.ip_address('127.0.0.1' if address.version == 4 else '::1')
if not 1 <= int(port) <= 65535: raise SystemExit('Invalid port')
print('http://' + ('[' + str(address) + ']' if address.version == 6 else str(address)) + ':' + port + '/healthz')
PY
) || fail 'Nieprawidłowy adres panelu WWW.'
# Prepare files before downtime. Keep the existing launcher/unit during this
# update so rollback needs only the controlled current symlink, not user data.
mkdir "$RELEASE"
cp -R "$ROOT/." "$RELEASE/"
chmod 0755 "$RELEASE/ultimatepr-station"
status stopping "$VERSION" 'Zatrzymywanie usługi po sprawdzeniu paczki…'
SWITCHED=1
stop_station_processes || fail 'Nie można zatrzymać poprzedniej instancji.'
rm -f "$CURRENT"
ln -s "$RELEASE" "$CURRENT"
status starting "$VERSION" 'Uruchamianie i weryfikacja nowej wersji…'
if ! start_and_wait; then
    exit 1
fi
# Rename a new helper into place; never truncate a script still being executed.
if [ "$MANAGER" = systemd ]; then
    install -m 0644 "$RELEASE/deploy/server/ultimatepr-update.service" /etc/systemd/system/ultimatepr-update.service
    install -m 0644 "$RELEASE/deploy/server/ultimatepr-update.path" /etc/systemd/system/ultimatepr-update.path
    systemctl daemon-reload
    systemctl enable --now ultimatepr-update.path
fi
install -m 0755 "$RELEASE/deploy/alpine/ultimatepr-update" /usr/local/libexec/ultimatepr-update.next
mv -f /usr/local/libexec/ultimatepr-update.next /usr/local/libexec/ultimatepr-update
status completed "$VERSION" "Aktualizacja zakończona pomyślnie. Dane zachowane. Odśwież kartę: Ctrl+F5 lub Ctrl+Shift+R (Windows/Linux). SHA-256 ZIP: $PACKAGE_SHA"
SWITCHED=0

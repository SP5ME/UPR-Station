# Closed build-context allowlist: ignored operator data beside Station sources
# must never be sent to Docker, even under an unexpected directory name.
**
!Cargo.toml
!Cargo.lock
!LICENSE
!TRADEMARKS.md
!Dockerfile
!.dockerignore
!src/
!src/**
!deploy/
!deploy/server/
!deploy/server/update-package.py
!deploy/server/update-release.py
!web/
!web/**
!messages/
!messages/*.txt
!languages/
!languages/*.lang
!assets/
!assets/branding/
!assets/branding/*.png
!assets/branding/*.ico
!scripts/
!scripts/desktop-licenses.py
!licenses/
!licenses/**
**/*.conf
**/*.token
**/*.password
**/*.log
**/__pycache__/
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx

